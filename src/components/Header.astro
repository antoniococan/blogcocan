
---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconX from "@/assets/icons/IconX.svg";
import LinkButton from "./LinkButton.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { site, features } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const mainSite = "https://antoniococan.github.io";
---

<a
  id="skip-to-content"
  href="#main-content"
  class="skip-link"
>
  {t.a11y.skipToContent}
</a>

<header id="mainNav">
  <div class="senli-container">

    <!-- Brand + Search -->
<div class="senli-brand-group">
  <a
    href={`${mainSite}/#page-top`}
    class="senli-brand"
  >
    {site.title}
  </a>

  {
    features.search !== false && (
      <LinkButton
        href={getRelativeLocaleUrl(locale, "search")}
        class="focus-outline control-button search-brand"
        title={t.nav.search}
        aria-label={t.nav.search}
      >
        <IconSearch class="size-5" />
      </LinkButton>
    )
  }
</div>

    <!-- Mobile menu button -->
    <button
      id="menu-btn"
      class="menu-btn"
      aria-label={t.a11y.openMenu}
      aria-expanded="false"
      aria-controls="menu-items"
      data-label-open={t.a11y.openMenu}
      data-label-close={t.a11y.closeMenu}
    >
      MENU
      <IconX id="close-icon" class="hidden size-5" />
      <IconMenuDeep id="menu-icon" class="size-5" />
    </button>

    <!-- Navigation -->
    <nav id="nav-menu" aria-label="Main navigation">
      <ul id="menu-items" class="senli-nav-list">

        <li>
          <a class="senli-nav-link"
             href={`${mainSite}/#page-top`}>
            HOME
          </a>
        </li>

        <li>
          <a class="senli-nav-link"
             href={`${mainSite}/#publications`}>
            PUBLICATIONS
          </a>
        </li>

        <li>
          <a class="senli-nav-link"
             href={`${mainSite}/#talks`}>
            CONFERENCES &amp; TALKS
          </a>
        </li>

        <li>
          <a class="senli-nav-link"
             href={`${mainSite}/#teaching`}>
            TEACHING
          </a>
        </li>

        <li>
          <a
            class="senli-nav-link active-link"
            href={getRelativeLocaleUrl(locale, "")}
            aria-current="page"
          >
            BLOG
          </a>
        </li>

        <!-- Dark/light theme -->
        {
          features.lightAndDarkMode && (
            <li class="nav-control">
              <button
                id="theme-btn"
                class="focus-outline control-button"
                title={t.a11y.toggleTheme}
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="size-6 dark:hidden" />
                <IconSunHigh class="size-6 hidden dark:block" />
              </button>
            </li>
          )
        }

      </ul>
    </nav>
  </div>
</header>

<script>
  function toggleNav() {
    const menuBtn = document.querySelector<HTMLButtonElement>("#menu-btn");
    const menuItems = document.querySelector("#menu-items");
    const menuIcon = document.querySelector("#menu-icon");
    const closeIcon = document.querySelector("#close-icon");

    if (!menuBtn || !menuItems || !menuIcon || !closeIcon) return;

    const openLabel = menuBtn.dataset.labelOpen ?? "Open menu";
    const closeLabel = menuBtn.dataset.labelClose ?? "Close menu";

    menuBtn.addEventListener("click", () => {
      const isOpen = menuBtn.getAttribute("aria-expanded") === "true";

      menuBtn.setAttribute("aria-expanded", String(!isOpen));
      menuBtn.setAttribute("aria-label", isOpen ? openLabel : closeLabel);

      menuItems.classList.toggle("menu-open");
      menuIcon.classList.toggle("hidden");
      closeIcon.classList.toggle("hidden");
    });
  }

  toggleNav();
  document.addEventListener("astro:after-swap", toggleNav);
</script>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Kanit:wght@400;500;600;700&family=Mulish:wght@400;500;600;700&display=swap");

  /* Navbar */

  #mainNav {
    position: sticky;
    top: 0;
    width: 100%;
    z-index: 10000;
    padding: 1rem 0;
    background-color: var(--background);
    border-bottom: 2px solid #154734;
    box-shadow: 0 0.125rem 0.25rem rgb(0 0 0 / 8%);
  }

  /* Bootstrap-style responsive container */

  .senli-container {
    width: 100%;
    margin-left: auto;
    margin-right: auto;
    padding-left: 3rem;
    padding-right: 3rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
  }

  @media (min-width: 992px) {
  .senli-container {
    max-width: min(1150px, 80vw);
  }
}

  /* Brand */

/* Brand + Search */

.senli-brand-group {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  flex-shrink: 0;
}

.search-brand {
  width: 2rem;
  height: 2rem;
  text-decoration: none;
  color: var(--foreground);
}

.search-brand:hover {
  color: #154734;
}

.senli-brand {
  display: inline-block;
  padding: 0.3125rem 0;
  margin-right: 0.5rem;
  font-family: "Kanit", sans-serif;
  font-size: 1.25rem;
  font-weight: 500;
  line-height: inherit;
  white-space: nowrap;
  text-decoration: none;
  color: var(--foreground);
}

  .senli-brand:hover {
    color: #154734;
  }

  /* Mobile menu button */

  .menu-btn {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--foreground);
    font-family: "Mulish", sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
  }

  /* Navigation */

  #nav-menu {
    width: 100%;
  }

  .senli-nav-list {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0;
    list-style: none;
    padding: 0;
    margin: 1rem 0;
  }

  .senli-nav-list.menu-open {
    display: flex;
  }

  .senli-nav-link {
    display: block;
    padding: 0.5rem 0;
    font-family: "Mulish", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    text-decoration: none;
    color: var(--foreground);
    transition: color 0.15s ease-in-out;
  }

  .senli-nav-link:hover,
  .senli-nav-link.active-link {
    color: #154734;
  }

  /* Search and theme controls */

  .nav-control {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .control-button {
    display: flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    color: var(--foreground);
  }

  .control-button:hover {
    color: #154734;
  }

  /* Desktop: Bootstrap navbar-expand-lg */

  @media (min-width: 992px) {
    .senli-container {
      flex-wrap: nowrap;
    }

    .menu-btn {
      display: none;
    }

    #nav-menu {
      display: flex;
      width: auto;
      justify-content: flex-end;
    }

    .senli-nav-list {
      display: flex;
      flex-direction: row;
      align-items: center;
      margin: 0 1.5rem 0 auto;
    }

    .senli-nav-link {
      padding: 0.5rem;
      margin-right: 1rem;
    }

    .nav-control {
      margin-left: 0.25rem;
    }
  }

  /* Skip navigation accessibility */

  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 10001;
    padding: 0.5rem 0.75rem;
    background: var(--background);
    color: #154734;
  }

  .skip-link:focus {
    top: 1rem;
  }
</style>
