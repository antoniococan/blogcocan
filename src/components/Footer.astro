
---
import type { HTMLAttributes } from "astro/types";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;
---

<footer
  class:list={["senli-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="senli-footer-container">
    <div id="copyright-text"></div>
    <div id="last-updated" class="last-updated"></div>

    <div class="footer-links">
      <a id="github-link" href="https://github.com/username">
        Github
      </a>
      <span>·</span>
      <a
        id="license-link"
        href="https://github.com/username/username.github.io/blob/main/LICENSE"
      >
        License
      </a>
    </div>
  </div>
</footer>

<script>
  async function updateFooter() {
    try {
      // Read the SAME config.yml used by the original website
      const response = await fetch("/contents/config.yml");

      if (!response.ok) {
        throw new Error("Could not load footer config");
      }

      const config = await response.text();

      const copyright = config.match(
        /^copyright-text:\s*["']?(.+?)["']?\s*$/m
      );

      const lastUpdated = config.match(
        /^last-updated:\s*["']?(.+?)["']?\s*$/m
      );

      if (copyright) {
        document.getElementById("copyright-text")!.textContent =
          copyright[1].replace(/^["']|["']$/g, "");
      }

      if (lastUpdated) {
        document.getElementById("last-updated")!.textContent =
          lastUpdated[1].replace(/^["']|["']$/g, "");
      }
    } catch {
  
    }
  }

  updateFooter();
  document.addEventListener("astro:page-load", updateFooter);
</script>

<style>
  .senli-footer {
    width: 100%;
    background-color: #154734;
    color: rgb(255 255 255 / 70%);
    text-align: center;
    padding: 3rem 0;
    font-size: 0.875rem;
  }

  .senli-footer-container {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 3rem;
  }

  .last-updated {
    margin-bottom: 0.5rem;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
  }

  .footer-links a {
    color: inherit;
    text-decoration: none;
  }

  .footer-links a:hover {
    color: #ffffff;
    text-decoration: underline;
  }
</style>
